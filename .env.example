# Stable source selection for local Docker builds. Override with a branch, tag,
# or exact 40-character commit SHA when intentionally testing another source.
SGLUNA_SOURCE_REF=main

# Factorio headless version baked into the local image build.
FACTORIO_VERSION=latest

# Host-side persistent data directory and Factorio UDP port.
SGLUNA_DATA_DIR=./data
SERVER_PORT=34197
SGLUNA_STOP_GRACE_PERIOD=90s

# Local RCON secret shared by devcontainer, E2E, and desktop-operator Compose.
# Keep the real value only in repo-root .env. Compose uses it for interpolation
# and passes it only through explicitly listed RCON environment variables.
FACTORIO_RCON_PASSWORD=

# SGLuna runtime configuration. These three provider values are required.
SGLUNA_ACTOR_MODE=npc
SGLUNA_CHAT_PLAYERS=
OPENAI_API_KEY=
OPENAI_API_BASEURL=
# Comma-separated model list: [0] is the main agent model (used exactly as a
# single model always was), [1] is a reserved subagent/plan-agent model.
OPENAI_MODEL=
# Optional: direct | router | local. Leave blank to keep the legacy
# PROVIDER_PROFILE-driven behaviour (including an explicit PROVIDER_PROFILE).
# direct/router require HTTPS; local also allows plain http to
# localhost/127.0.0.1/[::1]/host.docker.internal.
AI_API_METHOD=
# Optional Jev (TypeSafe) decision-provider key; blank disables Jev.
JEV_TYPESAFE_API_KEY=
PROVIDER_TIMEOUT_MS=300000
MAX_PROVIDER_REQUESTS_PER_HOUR=300
MAX_PROVIDER_OUTPUT_TOKENS_PER_TURN=100000
SHUTDOWN_TIMEOUT_MS=60000
SAVE_NAME=

# Factorio.com public-listing credentials.
# Leave BOTH blank for a private/unlisted server.
FACTORIO_USERNAME=
FACTORIO_TOKEN=
