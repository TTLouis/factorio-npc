# Cloud-sandbox template for the provider-backed stack (compose.yml +
# compose.e2e.yml). scripts/stack-cloud.sh copies it to the gitignored .env when
# none exists and generates FACTORIO_RCON_PASSWORD. Compose reads .env
# automatically; exported shell or cloud-environment variables override it.
# Never commit real keys: fill them only in .env or the environment settings.

# Source/Factorio pins. scripts/stack-cloud.sh builds the image from this
# checkout's pushed HEAD unless STACK_SOURCE_REF is set.
SGLUNA_SOURCE_REF=claude/docker-cloud-e2e-setup-psv6kx
FACTORIO_VERSION=2.0.77

# Persistent data stays under the gitignored test-results/ directory.
SGLUNA_DATA_DIR=./test-results/stack-data
SERVER_PORT=34197
SGLUNA_STOP_GRACE_PERIOD=90s

# Local RCON secret shared by compose.e2e.yml and scripts/stack-cloud.sh.
# RCON is published on 127.0.0.1 only.
FACTORIO_RCON_PASSWORD=
SGLUNA_RCON_HOST_PORT=27015

# Runtime. "<server>" lets goals typed on the server console/RCON (!luna ...)
# reach the NPC while no human player is connected.
SGLUNA_ACTOR_MODE=npc
SGLUNA_CHAT_PLAYERS='<server>'
PROVIDER_TIMEOUT_MS=300000
MAX_PROVIDER_REQUESTS_PER_HOUR=300
SHUTDOWN_TIMEOUT_MS=60000
SAVE_NAME=

# ---- Secrets: fill these in (or set them as cloud-environment variables) ----
# Main LLM, any OpenAI-compatible endpoint, e.g.
#   OPENAI_API_BASEURL=https://api.deepseek.com/v1   OPENAI_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_API_BASEURL=
OPENAI_MODEL=
# Jev (TypeSafe) decision provider; compose.e2e.yml passes it as TYPESAFE_API_KEY.
JEV_TYPESAFE_API_KEY=

# Leave both blank for a private/unlisted server.
FACTORIO_USERNAME=
FACTORIO_TOKEN=
