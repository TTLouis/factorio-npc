{
  "name": "factorio-npc-workspace",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.1",
  "description": "Headless-first autonomous NPC runtime, planning harness, and server deployment stack for Factorio.",
  "author": "TTLouis; originally derived from moeru-ai/airi-factorio by LemonNekoGH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TTLouis/factorio-npc"
  },
  "keywords": [
    "factorio",
    "npc",
    "llm",
    "agent",
    "headless",
    "automation",
    "typescript"
  ],
  "scripts": {
    "dev": "pnpm dev:packages",
    "build": "pnpm build:packages",
    "build:packages": "pnpm -r --filter=./packages/* run build",
    "dev:packages": "pnpm -r --filter=./packages/* run dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck",
    "test": "pnpm --filter @factorio-npc/agent --filter autorio.ts --if-present run test",
    "test:prompt": "pnpm --filter @factorio-npc/agent run test:prompt",
    "test:npc": "docker build -f tests/factorio/Dockerfile -t factorio-npc-test . && docker run --rm factorio-npc-test",
    "test:npc:cloud": "bash scripts/e2e-cloud.sh",
    "bootstrap": "node scripts/bootstrap.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@antfu/ni": "^28.2.0",
    "@types/node": "24",
    "eslint": "^9.39.3",
    "execa": "^9.6.1",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.2",
    "typed-factorio": "^3.35.0",
    "typescript": "~5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
