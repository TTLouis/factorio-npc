{
  "$schema": "https://raw.githubusercontent.com/TypeScriptToLua/TypeScriptToLua/master/tsconfig-schema.json",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "rootDir": "./src",
    "moduleResolution": "Node",
    "types": [
      "typed-factorio/runtime",
      "lua-types/jit"
    ],
    "strict": true,
    "outDir": "./dist"
  },
  "tstl": {
    "luaTarget": "JIT",
    "buildMode": "default",
    "luaLibImport": "require",
    "luaBundle": "control.lua",
    "luaBundleEntry": "src/control.ts",
    "noResolvePaths": ["crash-site"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/test-setup.ts",
    "src/test-event-registry.ts"
  ]
}
