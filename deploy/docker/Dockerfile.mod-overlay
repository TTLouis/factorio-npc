ARG BASE_IMAGE=factorio-npc:local

# Build the mod from this checkout the way the installer does: the same
# source preparation (the v8 deployment guard), typecheck, tests, Lua build and
# generated-Lua guard. The pnpm store is the one the Factorio test image uses,
# so a source-only change downloads nothing.
FROM node:22-bookworm AS mod-build
ENV CI=true
RUN corepack enable
WORKDIR /src
COPY package.json ./
RUN corepack install
COPY . .
RUN --mount=type=cache,id=npc-test-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --prefer-offline --store-dir /pnpm/store
RUN pnpm --filter @proj-airi/tstl-plugin-reload-factorio-mod run build
RUN pnpm --filter autorio.ts run test
RUN node deploy/pterodactyl/staging/source-preparer.mjs . deploy/pterodactyl/staging/guard.ts \
  && grep -q "^import './airi_deployment_guard'" packages/autorio/src/control.ts
RUN pnpm --filter autorio.ts run typecheck
RUN pnpm --filter autorio.ts run build
RUN cd packages/autorio && node scripts/check-generated-lua.mjs
RUN cp packages/autorio/info.json packages/autorio/dist/info.json

FROM ${BASE_IMAGE}

ARG MOD_SOURCE_SHA
COPY --from=mod-build /src/packages/autorio/dist/ /tmp/new-autorio/
COPY deploy/docker/update-mod-overlay.mjs /tmp/update-mod-overlay.mjs

RUN set -eux; \
  printf '%s' "$MOD_SOURCE_SHA" | grep -Eq '^[a-f0-9]{40}$'; \
  app="$(dirname "$(readlink -f /opt/airi/start-sgluna.sh)")"; \
  case "$app" in /opt/airi/.airi/releases/*) ;; *) exit 1;; esac; \
  test -f "$app/manifest.json"; \
  test -s /tmp/new-autorio/control.lua; \
  test -s /tmp/new-autorio/data.lua; \
  test -s /tmp/new-autorio/info.json; \
  grep -q 'airi-deploy-v8-npc-staging' /tmp/new-autorio/control.lua; \
  rm -rf "$app/autorio"; \
  mkdir -p "$app/autorio"; \
  cp -a /tmp/new-autorio/. "$app/autorio/"; \
  mkdir -p /tmp/client-mod/autorio_0.1.0; \
  cp -a "$app/autorio/." /tmp/client-mod/autorio_0.1.0/; \
  rm -f "$app/client-mod/autorio_0.1.0.zip"; \
  (cd /tmp/client-mod && zip -qr "$app/client-mod/autorio_0.1.0.zip" autorio_0.1.0); \
  cp "$app/client-mod/autorio_0.1.0.zip" /opt/airi/client-mods/autorio_0.1.0.zip; \
  (cd "$app/client-mod" && sha256sum autorio_0.1.0.zip > SHA256SUMS); \
  cp "$app/client-mod/SHA256SUMS" /opt/airi/client-mods/SHA256SUMS; \
  "$app/node/bin/node" /tmp/update-mod-overlay.mjs "$app" "$MOD_SOURCE_SHA"; \
  rm -rf /tmp/new-autorio /tmp/client-mod /tmp/update-mod-overlay.mjs
